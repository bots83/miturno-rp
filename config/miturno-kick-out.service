# Salida a Kick del servidor de video de MiTurno: ffmpeg lee la ruta ps5 de MediaMTX por RTSP local
# y la manda a Kick por RTMPS a 720p60. Se instala en /etc/systemd/system/ con
# scripts/video/desplegar-video.sh (repo principal).
#
# Arranca APAGADA y no se habilita nunca (no tiene [Install]): la encienden y la apagan miturno-rp
# (/control/kick_on y /control/kick_off, permitido por la regla de polkit 50-miturno-kick.rules) o el
# operador desde el admin. No se corta por un corte de la PS5: miturno-rp pasa al cartel y la ruta
# ps5 nunca se queda sin video.
#
# Destino:
# - lo arma kick_destino (/usr/local/lib/miturno/kick-destino.sh, tests en scripts/test-kick-destino.sh):
#   Kick usa Amazon IVS y la publicación va a rtmps://<ingesta>:443/app/<clave>; si a la URL cargada le
#   falta la ruta, agrega /app (y :443 en rtmps sin puerto);
# - por defecto, KICK_RTMP_URL + KICK_STREAM_KEY de /etc/miturno-video/kick.env (600 root; los carga
#   el usuario con sudo miturno-configurar-kick). systemd lee el archivo como root: la clave no está
#   en esta unidad ni en `systemctl show`;
# - KICK_DESTINO (opcional, con un drop-in) lo reemplaza sin tocar kick.env. La prueba de humo usa la
#   ruta local de MediaMTX:
#     [Service]
#     Environment=KICK_DESTINO=rtmp://127.0.0.1:1935/kick-humo
#
# La clave tiene que ir en los argumentos de ffmpeg (RTMP no tiene otra forma), y /proc no está montado
# con hidepid: cualquier proceso de otro usuario que NO tenga ProtectProc=invisible puede leer la línea
# de comandos de ffmpeg. ProtectProc protege a quien lo lleva puesto (no ve a los demás), no a ffmpeg.
# Por eso lo llevan los servicios expuestos a la red que corren con otro usuario: miturno-rp y
# MediaMTX (en sus unidades), y Caddy y coturn (el drop-in 50-miturno-procesos.conf que genera
# scripts/video/desplegar-video.sh del repo principal).
# Root y el usuario administrador miturno (que tiene sudo) la ven igual. Además, los mensajes de
# ffmpeg pasan por un filtro que tapa cualquier URL rtmp(s) y cualquier clave sk_… antes de llegar
# al journal.
#
# Parámetros (los medidos en el banco de pruebas): 1280×720 a 60 fps constantes (la PS5 entrega
# 59,94: el filtro fps duplica un cuadro cada ~17 s), x264 veryfast, tune zerolatency, sin B-frames,
# 4500 kbps CBR, keyframe cada 120 cuadros (2 s) sin cortes de escena, AAC 160 kbps 48 kHz estéreo.
#
# Cuadros para el vigilante de imagen (miturno-vigia): el video se decodifica una sola vez y split lo
# reparte. La rama de Kick es la de siempre; la otra saca 1 cuadro de cada 60 (~1 por segundo), a
# 960×540 en RGB, a /run/miturno-vigia/cuadro.ppm (tmpfs), que el clasificador lee cuando quiere.
# - framestep=60 y no fps=1: framestep cuenta cuadros y fps=1 sigue las marcas de tiempo (ante un
#   salto de marcas duplica o descarta cuadros). Además no lleva comas ni barras que escapar acá.
# - -fps_mode passthrough: la salida vigía no duplica ni descarta cuadros por su cuenta.
# - image2 con update=1 y atomic_writing=1: pisa siempre el mismo archivo, escribiendo a
#   cuadro.ppm.tmp y renombrando, así nunca se lee un cuadro a medias.
# - tee con onfail=ignore: si falla la escritura del cuadro (carpeta borrada, tmpfs lleno), se cae
#   solo esa salida y Kick sigue. El esclavo [f=null]- (no escribe nada y nunca falla) es necesario:
#   con un solo esclavo, ffmpeg 6.1.1 ignora onfail ("All tee outputs failed."), la falla llega al
#   muxer ("Error muxing a packet") y ffmpeg termina con 251 en vez de 0 (Kick sigue hasta el final,
#   pero el error queda guardado). Con el null, sale con 0 al terminar la entrada y con 255 ante SIGTERM.
# - Una salida de cuadros que falló queda muerta hasta el próximo arranque de kick-out, aunque la
#   carpeta vuelva. El vigilante lo ve como sin cuadros y, en modo activo con un turno, pausa por
#   servidor a los 15 s. Con kick-out apagado tampoco hay cuadros.
# - La carpeta es 0755 y el cuadro 0644 a propósito: es la misma imagen que sale por Kick.
[Unit]
Description=MiTurno: salida a Kick (ffmpeg 720p60 por RTMPS)
# After=miturno-rp: en un apagado o un deploy, systemd para primero kick-out (el orden de parada es
# el inverso del de arranque). Si se parara antes miturno-rp, ffmpeg se quedaría esperando la entrada
# y systemd lo mataría al vencer TimeoutStopSec. No es un Requires: kick-out no arranca miturno-rp.
After=network-online.target mediamtx.service miturno-rp.service
Wants=network-online.target
# Restart=always no tiene que rendirse nunca (el límite de arranques lo apagaría para siempre).
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=-/etc/miturno-video/kick.env
SyslogIdentifier=miturno-kick-out
# /run/miturno-vigia: la carpeta de los cuadros del vigilante (tmpfs, se borra al parar).
RuntimeDirectory=miturno-vigia
RuntimeDirectoryMode=0755
# $$ es un $ para bash (systemd no reemplaza nada: la clave nunca pasa por la línea de esta unidad).
ExecStart=/bin/bash -c '\
  set -u; \
  . /usr/local/lib/miturno/kick-destino.sh; \
  if ! destino=$$(kick_destino); then \
    echo "kick-out: falta /etc/miturno-video/kick.env con KICK_RTMP_URL (rtmps://…) y KICK_STREAM_KEY (cargalos con: sudo miturno-configurar-kick)" >&2; \
    exit 78; \
  fi; \
  unset KICK_STREAM_KEY KICK_RTMP_URL KICK_DESTINO; \
  exec /usr/bin/ffmpeg -hide_banner -nostdin -nostats -loglevel warning \
    -rtsp_transport tcp -timeout 5000000 -i rtsp://127.0.0.1:8554/ps5 \
    -filter_complex "[0:v:0]split=2[k][v];[k]scale=1280:720,fps=60,format=yuv420p[kick];[v]framestep=60,scale=960:540,format=rgb24[vigia]" \
    -map "[kick]" -map 0:a:0 \
    -c:v libx264 -preset veryfast -tune zerolatency -profile:v high -bf 0 \
    -b:v 4500k -maxrate 4500k -bufsize 4500k -g 120 -keyint_min 120 -sc_threshold 0 \
    -x264-params nal-hrd=cbr:keyint=120:min-keyint=120:scenecut=0 \
    -c:a aac -b:a 160k -ar 48000 -ac 2 \
    -f flv -flvflags no_duration_filesize "$$destino" \
    -map "[vigia]" -an -fps_mode passthrough -c:v ppm -f tee "[f=image2:update=1:atomic_writing=1:onfail=ignore]/run/miturno-vigia/cuadro.ppm|[f=null]-" \
    2> >(exec /usr/bin/sed -E -u -e "s#rtmps?://[^[:space:]]*#<destino oculto>#g" -e "s#sk_[A-Za-z0-9_-]+#<clave oculta>#g" >&2)'
# ffmpeg sale con 255 cuando lo paran con SIGTERM (kick_off): es un apagado normal, no una falla.
SuccessExitStatus=255
KillSignal=SIGTERM
TimeoutStopSec=5
# Si ffmpeg se cae (Kick cortó, MediaMTX se reinició), vuelve a intentar con espera creciente:
# 1 s, 2 s, 4 s… hasta 30 s. Sin kick.env (salida 78) no insiste.
Restart=always
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
RestartPreventExitStatus=78

# Sin privilegios (DynamicUser ya implica ProtectSystem=strict, PrivateTmp y NoNewPrivileges).
# ProtectProc acá solo evita que ffmpeg vea a los demás procesos; no oculta a ffmpeg.
CapabilityBoundingSet=
ProtectHome=true
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
